<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================================ -->
    <!-- Layout -->
    <!-- ================================================================================ -->

    <Style x:Key="RootScroll"
           TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="PageStack"
           TargetType="StackPanel">
        <Setter Property="Margin" Value="24" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Text -->
    <!-- ================================================================================ -->

    <Style x:Key="PageTitleTextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}" />

    <Style x:Key="PageDescriptionTextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SectionHeaderTextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Property -->
    <!-- ================================================================================ -->

    <Style x:Key="PropertyGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="24" />
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <Style x:Key="PropertyNameTextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="PropertyValueTextBlock"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

</ResourceDictionary>
